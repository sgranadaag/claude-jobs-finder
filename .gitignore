# Personal data: the folders stay in the repo (with .gitkeep), their contents don't.
# The format of each file is described in the README.

# Profile, CV, preferences, writing style and answer bank
docs/*
!docs/.gitkeep

# Offer history, application log and job boards (templates live in .claude/templates/data/)
data/*
!data/.gitkeep

# One folder per offer: tailored CV, application data and logs
applications/*
!applications/.gitkeep

# Local Claude Code settings
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
